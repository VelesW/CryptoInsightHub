# Copy to .env and replace values for local dev. NEVER commit the real .env.
NODE_ENV=development
PORT=4000

# 64+ random bytes hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

# Comma-separated origins permitted to send credentialed requests.
CORS_ORIGIN=http://localhost:5173

# SQLite path (relative to server/ cwd)
DB_PATH=./data/app.db
